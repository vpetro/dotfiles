layout uv

use envlocal

if [ -z "${VIRTUAL_ENV_PROMPT:-}" ] && [ -n "${VIRTUAL_ENV}" ]; then
   PYTHON_VERSION=$(python --version | /usr/bin/cut -d ' ' -f 2)
   VIRTUAL_ENV_PROMPT=" $PYTHON_VERSION"
fi
export VIRTUAL_ENV_PROMPT

# fix the prompt - something is trimming the space
export PROMPT="$PROMPT "

